    "icons": "Use Lucide-React-Native or Phosphor Icons (Thin weight) for a premium feel."
  },
  "instructions_to_main_agent": [
    "1. UPDATE THEME: Modify /app/frontend/constants/theme.ts to include the new 'Light Mode' palette and 'Typography' scale.",
    "2. REFACTOR LAYOUT: Update the main _layout.tsx to support a ThemeProvider that toggles between Light/Dark.",
    "3. ENHANCE EXPLORE: Rewrite the Explore screen to use a MasonryFlashList or a custom Bento Grid layout instead of a simple list.",
    "4. GLASSMORPHISM: Implement a reusable <GlassCard> component using expo-blur.",
    "5. NAVIGATION: Style the Tab Bar to be floating and detached from the bottom edge.",
    "6. DATA-TESTID: Ensure every interactive element (buttons, inputs, cards) has a unique testID prop."
  ],
  "universal_guidelines": [
    "Avoid generic 'App' centered text.",
    "Use 24px+ padding for all main containers.",
    "Never use pure black (#000) or pure white (#FFF) for backgrounds; tint them slightly.",
    "Ensure touch targets are at least 44x44pt."
  ]
}